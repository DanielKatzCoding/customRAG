# ============================================================
#  customRAG — environment variable reference
#  Committed to version control. Copy to .env and fill in real
#  values. Never commit .env itself.
# ============================================================

# ------------------------------------------------------------
#  Scraper (apps/scraper)
#  All variables are read by ScraperSettings (pydantic-settings)
# ------------------------------------------------------------

# Optional HTTP or SOCKS proxy URL.
# Leave blank (or omit entirely) to connect directly.
# SCRAPER_PROXY=http://user:pass@proxy-host:8080

# Per-request HTTP timeout in seconds.
SCRAPER_TIMEOUT_SECONDS=30.0

# Accept-Language header sent with every request.
SCRAPER_ACCEPT_LANGUAGE=en-US,en;q=0.9,he;q=0.8

# ------------------------------------------------------------
#  Future workspace members — add prefixed blocks below:
#
#  Ingest service (apps/ingest)
#  INGEST_CHUNK_SIZE=512
#  INGEST_OVERLAP=64
#
#  API service (apps/api)
#  API_HOST=0.0.0.0
#  API_PORT=8000
# ------------------------------------------------------------
