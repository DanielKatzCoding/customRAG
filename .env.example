# ============================================================
#  customRAG — environment variable reference
#  Committed to version control. Copy to .env and fill in real
#  values. Never commit .env itself.
# ============================================================

# ------------------------------------------------------------
#  Scraper (apps/scraper)
#  All variables are read by ScraperSettings (pydantic-settings)
# ------------------------------------------------------------

SCRAPER_HOST=127.0.0.1
SCRAPER_PORT=8000
SCRAPER_LOG_LEVEL=INFO
SCRAPER_OUTPUT_DIR=./output_scrape

# Optional HTTP or SOCKS proxy URL. Leave blank to connect directly.
# SCRAPER_PROXY=http://user:pass@proxy-host:8080

SCRAPER_TIMEOUT_SECONDS=30.0
SCRAPER_ACCEPT_LANGUAGE=en-US,en;q=0.9,he;q=0.8

# ------------------------------------------------------------
#  RAG service (apps/rag)
#  All variables are read by RagSettings (pydantic-settings)
# ------------------------------------------------------------

RAG_HOST=127.0.0.1
RAG_PORT=8001
RAG_LOG_LEVEL=INFO

# ChromaDB persistent storage path (relative to apps/rag/)
RAG_CHROMA_PATH=./chroma_db
RAG_COLLECTION_NAME=hebrew_news

# Path to scraper output (relative to apps/rag/)
RAG_OUTPUT_DIR=../scraper/output_scrape

# Embedding model
RAG_EMBEDDING_MODEL=dicta-il/dictabert
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_BATCH_SIZE=32

# Chunking
RAG_CHUNK_THRESHOLD_PERCENTILE=85
RAG_CHUNK_MAX_CHARS=1200
RAG_CHUNK_TOKEN_SIZE=256

# Search
RAG_SEARCH_DEFAULT_TOP_K=5
